# dump mdz with atoms coming and going: run with
#   lmp -var plugin /path/to/mdzplugin.so -in in.variable
# then python3 check.py /path/to/mdz (see run.sh).
plugin load ${plugin}
units metal
atom_style atomic
lattice fcc 5.26
region box block 0 3 0 3 0 6
create_box 2 box
region low block INF INF INF INF 0 2.5
create_atoms 1 region low
pair_style lj/cut 8.5
pair_coeff * * 0.0104 3.4
mass * 39.948
velocity all create 60.0 4928459 loop geom
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
fix 1 all nve

dump ref all custom 5 ref_var.dump id type x y z ix iy iz vx vy vz
dump_modify ref sort id format float %.17g time yes
dump var all mdz 5 var.mdz id type x y z ix iy iz vx vy vz
dump_modify var variable yes lossless yes gof 3
# without variable yes, frames whose atoms differ are skipped and the run continues
# with no fields listed: id type x y z ix iy iz
dump fixed all mdz 5 fixed.mdz
dump_modify fixed lossless yes

# atoms arrive ...
region top block 0 3 0 3 4.0 5.0
fix dep all deposit 3 2 4 29494 region top near 1.0 attempt 50
run 20
unfix dep
# ... and leave
delete_atoms random fraction 0.2 yes all NULL 482793
run 20
