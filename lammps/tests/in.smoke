# Smoke test for dump mdz: run with
#   lmp -var plugin /path/to/mdzplugin.so -in in.smoke
# then python3 check.py /path/to/mdz (see run.sh).
plugin load ${plugin}
units metal
atom_style atomic
lattice fcc 5.26
region box prism 0 4 0 4 0 4 1.1 0.6 -0.8
create_box 2 box
create_atoms 1 box
set type 1 type/fraction 2 0.25 999
pair_style lj/cut 8.5
pair_coeff * * 0.0104 3.4
mass * 39.948
velocity all create 120.0 4928459 loop geom
neighbor 2.0 bin
fix 1 all npt temp 120 120 0.1 tri 0 0 1.0

compute pe all pe/atom
variable ke atom 0.5*mass*(vx*vx+vy*vy+vz*vz)

# general fields (a compute, a per-atom variable and an integer) next to the
# standard ones
dump ref all custom 10 ref.dump id type x y z ix iy iz vx vy vz fx fy fz c_pe v_ke proc
dump_modify ref sort id format float %.17g time yes
dump exact all mdz 10 exact.mdz id type x y z ix iy iz vx vy vz fx fy fz c_pe v_ke proc
dump_modify exact lossless yes gof 4
# lossy positions, and a general field stored to a precision
dump lossy all mdz 10 lossy.mdz id type x y z ix iy iz c_pe
dump_modify lossy precision 0.0005 precision/column c_pe 0.002

run 60
undump exact
undump lossy
undump ref

# a second segment appended to the same files
dump ref2 all custom 10 ref2.dump id type x y z ix iy iz vx vy vz fx fy fz c_pe v_ke proc
dump_modify ref2 sort id format float %.17g time yes first no
dump exact2 all mdz 10 exact.mdz id type x y z ix iy iz vx vy vz fx fy fz c_pe v_ke proc
dump_modify exact2 lossless yes gof 4 append yes first no
run 40
