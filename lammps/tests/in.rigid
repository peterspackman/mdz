# dump mdz with rigid bodies taken from the molecules: run with
#   lmp -var plugin /path/to/mdzplugin.so -in in.rigid
# then python3 check.py /path/to/mdz (see run.sh).
plugin load ${plugin}
units metal
atom_style molecular
lattice sc 4.0
region box block 0 4 0 4 0 4
create_box 2 box
molecule tri ${dir}/tri.mol
create_atoms 0 box mol tri 4242
pair_style lj/cut 6.0
pair_coeff * * 0.0104 3.0
mass * 39.948
velocity all create 300.0 4928459 loop geom
neighbor 2.0 bin
neigh_modify exclude molecule/intra all
fix 1 all rigid/nve molecule

dump ref all custom 10 ref_rigid.dump id type x y z ix iy iz mol
dump_modify ref sort id format float %.17g time yes
dump rigid all mdz 10 rigid.mdz id type x y z ix iy iz mol
dump_modify rigid rigid mol precision 0.0005 gof 4
run 80
